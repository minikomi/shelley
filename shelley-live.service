[Unit]
Description=Shelley Live experimental voice interface
After=network-online.target shelley.service
Wants=network-online.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/shelley
ExecStart=/home/exedev/shelley/bin/shelley-live
Restart=on-failure
RestartSec=3
Environment=HOME=/home/exedev
Environment=SHELLEY_URL=unix:///home/exedev/.config/shelley/shelley.sock
Environment=SHELLEY_LIVE_CWD=/home/exedev/shelley
Environment=SHELLEY_LIVE_ROOT=/home/exedev
Environment=SHELLEY_PUBLIC_URL=https://exedevwork.exe.xyz
Environment=SHELLEY_USER_EMAIL=adam@poyo.co

[Install]
WantedBy=multi-user.target
